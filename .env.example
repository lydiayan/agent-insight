# Host ports are bound to 127.0.0.1 by default.
FRONTEND_HOST_PORT=13000
BACKEND_HOST_PORT=8080
MYSQL_HOST_PORT=13316
REDIS_HOST_PORT=16389
ELASTICSEARCH_HOST_PORT=19201
ELASTICSEARCH_JAVA_OPTS=-Xms256m -Xmx256m -XX:ActiveProcessorCount=2

# Local demonstration credentials. Replace them outside a local machine.
MYSQL_DATABASE=agent_insight
MYSQL_USER=agent_insight
MYSQL_PASSWORD=agent-insight-dev
MYSQL_ROOT_PASSWORD=agent-insight-root-dev

# AgentInsight reads traces from this Elasticsearch index.
AGENT_INSIGHT_TRACE_INDEX=rag-traces

# The evaluation endpoint is called by the backend container. host.docker.internal
# points to the host machine where ecommerce-order-agent-platform runs on port 8087.
AGENT_EVALUATION_ENDPOINT=http://host.docker.internal:8087/internal/evaluation/ask
AGENT_EVALUATION_TOKEN=local-evaluation-token-change-me
